# FlixCasa Pro — Environment Configuration

# TMDB API key (required for poster grids & metadata)
TMDB_API_KEY=your_tmdb_api_key_here

# Supabase public browser client
NEXT_PUBLIC_SUPABASE_URL=https://kzwcibrkcufjwckcwdfv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase browser client configuration
NEXT_PUBLIC_SUPABASE_URL=https://kzwcibrkcufjwckcwdfv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VERCEL_DEPLOY_HOOK=

# Telegram MTProto credentials (server-only; never use NEXT_PUBLIC_ prefix)
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
# Optional GramJS StringSession for authenticated public-channel searches
TELEGRAM_SESSION=

# Optional direct media providers. Keep all provider credentials server-only.
IPFS_GATEWAY=https://ipfs.io
IPFS_STREAM_API=

# JWT secret for secure session cookies (min 32 chars)
JWT_SECRET=change-this-to-a-random-32-char-secret

# AES-256 server-side encryption secret
ENCRYPTION_SECRET=change-this-server-encryption-key-32

# Root admin email — protected from block/delete
ROOT_ADMIN_EMAIL=admin@flixcasa.local

# Standalone admin portal credentials (set these privately; never commit real passwords)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password

# CasaOS download directory (mounted volume)
DOWNLOAD_PATH=/DATA/Downloads/Movies

# CasaOS hostname for admin panel access
CASAOS_HOST=casaos.local

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=https://flix-casa-pro-v2.vercel.app

# Node environment
NODE_ENV=production

# Client version enforced by the server-side force-update control
NEXT_PUBLIC_APP_VERSION=0.1.0

# Variant values: standard, pro, tv
NEXT_PUBLIC_APP_VARIANT=standard
NEXT_PUBLIC_STANDARD_MIDROLL_AD_URL="https://pl31462671.profitableratecpmnetwork.com/b2/62/f2/b262f2ac3840ab3ccf650aad61e5a4db.js"

# Optional reviewable AI assistant proxy used by the admin preview panel
AI_API_URL=

# Optional remote URL for the Electron admin shell during development
FLIXCASA_ADMIN_URL=http://localhost:3000
